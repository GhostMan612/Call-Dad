# gitignore — Call-Dad
# Secrets / signing / Firebase — NEVER commit
.env
local.properties
# Release signing config (BP-05 §5). Holds the keystore path AND both
# passwords — the app's signing identity. The template is committed; the
# filled-in copy is not. docs/release-signing.md
keystore.properties
*.keystore
*.jks
google-services.json
firebase-service-account*.json
RELEASE_*.txt

# Gradle / Android build outputs (human builds in Studio; this lane never builds)
.gradle/
.kotlin/
gradle/gradle-daemon-jvm.properties
build/
app/build/
*/build/
captures/
.externalNativeBuild/
.cxx/

# IDE
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Manifests / local media trays (generated, not source)
*.csv
fixtures/inbox/
assets/inbox/

# Python
__pycache__/
*.pyc
.venv*/
.pytest_cache/

# Node (relay tooling, if any)
/relay/node_modules/

# Phase 5: Cloud Functions + local env (never commit installs or secrets)
functions/node_modules/
functions/.env

# Firestore rules test harness (npm install locally) + emulator debug logs
tools/rules-test/node_modules/
tools/rules-test/package-lock.json
firestore-debug.log
*-debug.log
