{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "gradlew*assemble*": "ask",
      "gradlew*install*": "ask",
      "gradlew*connected*": "ask",
      "gradlew*clean*": "ask",
      "adb*install*": "ask",
      "adb*uninstall*": "deny",
      "adb*push*": "deny",
      "adb*root*": "deny",
      "adb*shell*pm*": "deny",
      "adb*logcat*": "allow",
      "adb*devices*": "allow",
      "adb*shell*getprop*": "allow",
      "adb*shell*dumpsys*": "allow",
      "firebase*deploy*": "deny",
      "firebase*deploy*--only firestore:rules": "allow",
      "git*add*-A*": "deny",
      "git*add*--all*": "deny",
      "git*add*-u*": "deny",
      "git*add*": "ask",
      "git*commit*": "ask",
      "git*push*--force*": "deny",
      "git*push*": "ask",
      "git*reset*--hard*": "ask",
      "cat*": "deny",
      "type*": "deny",
      "more*": "deny",
      "head*": "deny",
      "tail*": "deny",
      "Get-Content*": "deny",
      "Select-String*": "deny",
      "findstr*": "deny",
      "rg*": "deny",
      "grep*": "deny",
      "Set-Content*": "deny",
      "Add-Content*": "deny",
      "Out-File*": "deny",
      "Test-Path*": "deny",
      "Get-ChildItem*": "deny",
      "dir*": "deny",
      "ls*": "deny",
      "echo*>*": "deny",
      "sed*": "deny",
      "tee*": "deny",
      "python*-c*": "deny",
      "python*-m*": "deny",
      "node*-e*": "deny",
      "node*--eval*": "deny",
      "bash*": "deny",
      "sh*": "deny",
      "wsl*": "deny",
      "cmd*": "deny",
      "Start-Process*": "deny",
      "Invoke-Expression*": "deny",
      "ForEach-Object*": "deny",
      "Where-Object*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "C:/Call-Dad/**": "allow",
      "C:/android/**": "allow",
      "C:/venv-hub/**": "allow",
      "C:/Program Files/**": "deny",
      "C:/Program Files (x86)/**": "deny",
      "C:/ProgramData/**": "deny",
      "C:/Users/<USER>/AppData/Local/Temp/opencode/**": "allow"
    }
  },
  "references": {
    "blueprints": {
      "path": "blueprints",
      "description": "Call-Dad architecture, ADRs, checklists, blueprints — read before any code change"
    },
    "docs": {
      "path": "docs",
      "description": "Call-Dad setup, device, firebase-plan, kid-safe-ux, donor-reuse notes"
    }
  },
  "tool_output": {
    "max_lines": 400
  }
}
