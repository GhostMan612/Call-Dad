{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "gradlew*assemble*": "ask",
      "gradlew*install*": "ask",
      "gradlew*connected*": "ask",
      "gradlew*clean*": "ask",
      "adb*install*": "ask",
      "adb*uninstall*": "deny",
      "adb*push*": "deny",
      "adb*root*": "deny",
      "adb*shell*pm*": "deny",
      "adb*logcat*": "allow",
      "adb*devices*": "allow",
      "adb*shell*getprop*": "allow",
      "adb*shell*dumpsys*": "allow",
      "firebase*deploy*": "deny",
      "//": "Operator-authorized 2026-10-03, for ONE task: the consent-read, chunk-cap and negotiationRound rule fixes plus the ring-push TTL/retry change had never been released, which left the app inert on every device. Deliberately NARROW and deliberately `ask`, not `allow`: it names one exact command, so no blanket firebase write is possible and it still stops for a human. The blanket deny above stays as the floor for everything else -- hosting, database, storage, `firebase use`. This mirrors the narrow allow that existed for the 2026-10-01 rules release and was removed afterwards; remove this one again once the deploy is done, because an allow that outlives its one use is a hole in the law.",
      "firebase deploy --only firestore:rules,functions": "ask",
      "git*add*-A*": "deny",
      "git*add*--all*": "deny",
      "git*add*-u*": "deny",
      "git*add*": "ask",
      "git*commit*": "ask",
      "git*push*--force*": "deny",
      "git*push*": "ask",
      "git*reset*--hard*": "ask",
      "cat*": "deny",
      "type*": "deny",
      "more*": "deny",
      "head*": "deny",
      "tail*": "deny",
      "Get-Content*": "deny",
      "Select-String*": "deny",
      "findstr*": "deny",
      "rg*": "deny",
      "grep*": "deny",
      "Set-Content*": "deny",
      "Add-Content*": "deny",
      "Out-File*": "deny",
      "Test-Path*": "deny",
      "Get-ChildItem*": "deny",
      "dir*": "deny",
      "ls*": "deny",
      "echo*>*": "deny",
      "sed*": "deny",
      "tee*": "deny",
      "python*-c*": "deny",
      "python*-m*": "deny",
      "node*-e*": "deny",
      "node*--eval*": "deny",
      "bash*": "deny",
      "sh*": "deny",
      "wsl*": "deny",
      "cmd*": "deny",
      "Start-Process*": "deny",
      "Invoke-Expression*": "deny",
      "ForEach-Object*": "deny",
      "Where-Object*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "C:/Call-Dad/**": "allow",
      "C:/android/**": "allow",
      "C:/venv-hub/**": "allow",
      "C:/Program Files/**": "deny",
      "C:/Program Files (x86)/**": "deny",
      "C:/ProgramData/**": "deny",
      "C:/Users/<USER>/AppData/Local/Temp/opencode/**": "allow"
    }
  },
  "references": {
    "blueprints": {
      "path": "blueprints",
      "description": "Call-Dad architecture, ADRs, checklists, blueprints — read before any code change"
    },
    "docs": {
      "path": "docs",
      "description": "Call-Dad setup, device, firebase-plan, kid-safe-ux, donor-reuse notes"
    }
  },
  "tool_output": {
    "max_lines": 400
  }
}
