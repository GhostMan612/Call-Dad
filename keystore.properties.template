# Release signing config template — copy to `keystore.properties` at the REPO ROOT.
#
# `keystore.properties` is gitignored. NEVER commit the filled-in copy: the
# keystore and these four values are the app's signing identity, and RULES §1.3
# plus tools/verify_project.py ban that outright.
#
# Full instructions: docs/release-signing.md

# Absolute path to the keystore file. Keep it OUTSIDE the repo (e.g. under
# C:\android\). A keystore inside the repo is a keystore that ends up in every
# backup and sync of the source tree.
#
# In a .properties file, `:` and the first `=` must be escaped with a backslash.
storeFile=C\:\\android\\calldad-release.keystore

# Password for the keystore itself.
storePassword=

# Alias from step 1 of keytool -genkeypair (we used "calldad").
keyAlias=calldad

# Password for the private key inside the keystore. May equal storePassword.
keyPassword=