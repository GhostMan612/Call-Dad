rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: owner-only. Holds this device's FCM token; the Cloud
    // Function reads it with admin rights to ring exactly the callee.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Calls: one room per paired couple (ADR-015). The doc id IS the two
    // member UIDs, sorted and joined with '_', so every rule authorizes
    // from the id alone: no resource.data read, which means the publish
    // transaction's pre-read of a not-yet-existing room still works.
    // Nobody outside the pair can read the SDP/ICE, create the room, or
    // squat it; a reinstall (new UID) simply pairs into a new room.
    match /calls/{callId} {

      function members() {
        return callId.split('_');
      }

      function isMember() {
        return request.auth != null
            && members().size() == 2
            && request.auth.uid in members();
      }

      // The written parties must be exactly the two members, distinct.
      function partiesValid(data) {
        return data.callerUid in members()
            && data.calleeUid in members()
            && data.callerUid != data.calleeUid;
      }

      function statusValid(data) {
        return data.status in ['RINGING', 'CONNECTED', 'DECLINED', 'ENDED'];
      }

      allow get: if isMember();

      // List: denied. Clients address their one room by id.
      allow list: if false;

      // Create: only a member, calling as themselves, starting RINGING.
      allow create: if isMember()
                    && partiesValid(request.resource.data)
                    && request.resource.data.callerUid == request.auth.uid
                    && request.resource.data.status == 'RINGING'
                    && request.resource.data.seq is int;

      // Update: members only. A new generation (seq bump) must be a
      // RINGING offer by the writer; within a generation the parties are
      // frozen and seq never moves backwards.
      //
      // `negotiationRound` is the same-generation ICE-restart counter (K21
      // reconnect). It is monotonic WITHIN a generation: a round may not go
      // backwards, because a late answer to an earlier offer would otherwise look
      // newer than the offer it is answering, and the caller would discard it.
      // Zero/absent is the original handshake.
      allow update: if isMember()
                    && partiesValid(request.resource.data)
                    && statusValid(request.resource.data)
                    && request.resource.data.seq is int
                    && request.resource.data.seq >= resource.data.seq
                    && (!request.resource.data.keys().hasAny(['negotiationRound'])
                          || (request.resource.data.negotiationRound is int
                              && request.resource.data.negotiationRound >= 0
                              && (!resource.data.keys().hasAny(['negotiationRound'])
                                  || request.resource.data.negotiationRound
                                     >= resource.data.negotiationRound)))
                    && (request.resource.data.seq == resource.data.seq
                          ? (request.resource.data.callerUid == resource.data.callerUid
                             && request.resource.data.calleeUid == resource.data.calleeUid)
                          : (request.resource.data.status == 'RINGING'
                             && request.resource.data.callerUid == request.auth.uid));

      // Delete: a TERMINAL room may be removed by a member; a live one may
      // not. This was `if false` for every case, which meant that after a
      // reinstall (new UID, new room) the old room and its clips were
      // permanently orphaned -- written by an account that no longer exists on
      // the phone, undeletable by anyone, accruing storage forever. Cleanup is
      // safe exactly when there is nothing left to ring for: a RINGING or
      // CONNECTED room is still a live call and is never deletable.
      allow delete: if isMember()
                    && resource.data.status in ['ENDED', 'DECLINED'];

      // Walkie-talkie voice clips (ADR-016). Same two members only. The
      // sender stamps itself and the server time; clips are small AAC
      // bytes. The listener plays then deletes; either member may delete.
      match /ptt/{clipId} {
        allow read: if isMember();
        allow create: if isMember()
                      && request.resource.data.from == request.auth.uid
                      && request.resource.data.audio is bytes
                      && request.resource.data.audio.size() <= 200000
                      && request.resource.data.durationMs is int
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.keys().hasOnly(
                           ['from', 'audio', 'durationMs', 'createdAt']);
        allow update: if false;
        allow delete: if isMember();
      }

      // Dad<->Kid text thread (SPEC_SHEET §2.3, BP-03).
      //
      // Create is the interesting one. The body is bounded in the RULES, not
      // just in the app: `ChatText.validate` is a client check on a phone the
      // parent does not control, so a modified build, a replayed request, or a
      // future caller that forgets the check would otherwise write anything the
      // rules accept. The app additionally refuses link-shaped text, because
      // the rules cannot tell "a url" from "a sentence" without becoming a
      // language parser; the size and field rules below are what the server can
      // actually guarantee.
      match /chat/{messageId} {
        function chatCreateFields() {
          return request.resource.data.keys().hasOnly(
                   ['from', 'body', 'createdAt', 'deliveredAt', 'readAt']);
        }
        function chatCreateClean() {
          return !request.resource.data.keys().hasAny(['deliveredAt', 'readAt']);
        }
        function chatBodyOk() {
          return request.resource.data.body is string
              && request.resource.data.body.size() > 0
              && request.resource.data.body.size() <= 500;
        }
        allow read: if isMember();
        allow create: if isMember()
                      && request.resource.data.from == request.auth.uid
                      && chatBodyOk()
                      && request.resource.data.createdAt == request.time
                      && chatCreateFields()
                      && chatCreateClean();
        // Receipts only. A member may advance deliveredAt/readAt on any message
        // but may NOT change who sent it or what it says: rewriting a child's
        // own words, or the sender, is the one update a mutual allowlist pair
        // must not permit, because "dad" is the only other party and this app
        // must never be able to show a child words the grown-up did not send.
        allow update: if isMember()
                      && request.resource.data.from == resource.data.from
                      && request.resource.data.body == resource.data.body
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.keys().hasOnly(
                           ['from', 'body', 'createdAt', 'deliveredAt', 'readAt'])
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['deliveredAt', 'readAt']);
        allow delete: if isMember();
      }

      // Photo shares (SPEC_SHEET §2.4, BP-04). The parent doc carries the
      // verified digest; chunks hang off it. Byte size is capped here so a
      // corrupted or hostile writer cannot fill a family's storage, and the
      // 9MB Firestore document limit is respected by construction.
      match /photos/{photoId} {
        function photoMetaFields() {
          return request.resource.data.keys().hasOnly(
                   ['from', 'totalBytes', 'chunkCount', 'sha256', 'mime', 'width', 'height', 'createdAt']);
        }
        allow read: if isMember();
        allow create: if isMember()
                      && request.resource.data.from == request.auth.uid
                      && request.resource.data.totalBytes is int
                      && request.resource.data.totalBytes > 0
                      && request.resource.data.totalBytes <= 800000
                      && request.resource.data.chunkCount is int
                      && request.resource.data.chunkCount > 0
                      && request.resource.data.chunkCount <= 32
                      && request.resource.data.sha256 is string
                      && request.resource.data.sha256.size() == 64
                      && request.resource.data.mime == 'image/webp'
                      && request.resource.data.createdAt == request.time
                      && photoMetaFields();
        // Metadata is immutable once written: a sender must not be able to swap
        // the digest or the size after the fact and make a failed transfer
        // look verified.
        allow update: if false;
        allow delete: if isMember();

        match /chunks/{index} {
          function chunkOk() {
            return request.resource.data.from == request.auth.uid
                && request.resource.data.bytes is bytes
                && request.resource.data.bytes.size() > 0
                && request.resource.data.bytes.size() <= 256000
                && request.resource.data.index is int
                && request.resource.data.index == int(index)
                && request.resource.data.keys().hasOnly(
                     ['from', 'bytes', 'index', 'createdAt']);
          }
          allow read: if isMember();
          allow create: if chunkOk() && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if isMember();
        }
      }

      // Consent certs and the kill switch (SPEC_SHEET §4, BP-05 §2, ADR-017).
      //
      // One doc per grantee: `calls/{room}/consents/{granteeUid}`.
      //
      // THE LOAD-BEARING RULE IS WHO MAY WRITE. A grant must come from the PEER
      // of the grantee, so a child can never authorise itself: a cert whose
      // grantorUid is the grantee itself, or anyone but the paired peer, is
      // denied. "The kid consented" proves nothing if the kid wrote the consent,
      // and a self-issued cert is the single most likely way a consent feature
      // becomes decorative.
      //
      // This is what lets the signature be deferred: the room id is the two
      // UIDs, so "a member of this pair" is already established by the room
      // itself. ADR-017 records the trust-root question that remains.
      match /consents/{granteeUid} {
        function grantorIsThePeer(data) {
          return data.granteeUid is string
              && data.granteeUid == granteeUid
              && data.granteeUid in members()
              && data.grantorUid is string
              && data.grantorUid == request.auth.uid
              && data.grantorUid != granteeUid;
        }
        function grantFieldsOk(data) {
          return data.keys().hasOnly(
                   ['granteeUid', 'grantorUid', 'scopes', 'grantSeq',
                    'grantedAt', 'expiresAt'])
              && data.grantedAt == request.time
              && data.expiresAt is timestamp
              && data.expiresAt > request.time
              && data.expiresAt <= request.time + duration.value(90, 'd')
              && data.grantSeq is int
              && data.grantSeq >= 1
              && data.scopes is list
              && data.scopes.size() > 0
              && data.scopes.size() <= 4
              && data.scopes.hasOnly(['CALL', 'TEXT', 'PHOTO', 'PTT'])
              && data.granteeUid == granteeUid;
        }
        allow read: if isMember() && granteeUid in members();

        // The current grant. A parent may CREATE it and REPLACE it (a renewal,
        // or a deliberate re-grant after a revoke), and the sequence must go
        // FORWARD -- that is what makes re-granting after a revoke a visible,
        // auditable act rather than something a stale write can achieve by
        // accident. `set` from the client is an update once the doc exists, so
        // both paths are covered.
        allow create: if isMember()
                      && grantorIsThePeer(request.resource.data)
                      && grantFieldsOk(request.resource.data);

        allow update: if isMember()
                      && grantorIsThePeer(request.resource.data)
                      && grantorIsThePeer(resource.data)
                      && request.resource.data.grantSeq > resource.data.grantSeq
                      && grantFieldsOk(request.resource.data);

        // A grant is never deleted: `delete: if false` is the floor under the
        // whole feature. Losing the grant document must not silently hand the
        // device MORE authority, and a room whose pair has gone away is cleaned
        // up by the whole-room delete rules above, not field by field.
        allow delete: if false;
      }

      // Revocations are APPEND-ONLY auto-id documents in a room-level
      // subcollection: `calls/{room}/revocations/{auto}`.
      //
      // Two emulator failures shaped this path, and both are worth the comment:
      //
      //  - NOT a `revokedAt` flag on the grant document. A grant write replaces
      //    the grant document, and the flag goes with it, so the child is
      //    un-revoked with no trace. No grant write can reach this collection,
      //    and `update`/`delete` are both `false`, so a written revocation is
      //    permanent for this pairing.
      //  - NOT nested under the grant doc. `consents/{grantee}/revocations/...`
      //    is three path segments below the room, and there a rule referencing a
      //    wildcard bound in an ANCESTOR match block threw an EVALUATION ERROR
      //    instead of denying. An evaluation error is indistinguishable from a
      //    permission problem in a log line, so a correct denial nearly got read
      //    as "the kill switch is broken". One level below the room is the
      //    shape `ptt` and `chat` already use and is proven to work, so
      //    `granteeUid` travels in the document rather than in the path.
      match /revocations/{revocationId} {
        function revocationOk(data) {
          return data.keys().hasOnly(
                   ['granteeUid', 'grantorUid', 'revokesGrantSeq', 'revokedAt'])
              && data.granteeUid is string
              && data.granteeUid in members()
              && data.grantorUid is string
              && data.grantorUid == request.auth.uid
              && data.grantorUid != data.granteeUid
              && data.revokesGrantSeq is int
              && data.revokesGrantSeq >= 0
              && data.revokedAt == request.time;
        }
        allow read: if isMember();
        allow create: if isMember() && revocationOk(request.resource.data);
        // Permanent. Not "until the parent changes their mind": that is what a
        // higher grantSeq is for, and making it a delete would reintroduce
        // exactly the lost-write hole this structure exists to close.
        allow update: if false;
        allow delete: if false;
      }
    }

    // Pairing handshake docs: pairings/{uid} = {uid, peerUid, sessionNonce,
    // expiresAt}.
    //
    // READ is closed to the two named parties. It was `request.auth != null`,
    // i.e. any anonymous install in the world could read any pairing doc by id
    // and learn a real UID, a real peer UID, and a live handshake nonce.
    // `list` was already denied so nobody could enumerate, but ids are guessable
    // once a UID leaks through any channel, and a nonce is exactly the secret
    // the mutual handshake is built on: reading it is half of hijacking a
    // pairing. The peer still sees it, which is the only read the handshake
    // needs, because the owner has already written their doc by then.
    match /pairings/{uid} {
      allow get: if request.auth != null
                 && (request.auth.uid == uid
                     || (resource.data.peerUid == request.auth.uid));

      allow list: if false;

      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.uid == uid
                            && request.resource.data.peerUid is string
                            && request.resource.data.peerUid != uid
                            && request.resource.data.sessionNonce is string
                            && request.resource.data.expiresAt is timestamp
                            && request.resource.data.expiresAt > request.time
                            && request.resource.data.expiresAt <
                               request.time + duration.value(25, 'm');

      // Only an expired handshake may be cleared early. An unexpired one is
      // live state: a phone mid-scan must not have it yanked away by the other
      // side, which would strand the pair between the two writes.
      allow delete: if request.auth != null
                    && request.auth.uid == uid
                    && resource.data.expiresAt < request.time;
    }
  }
}
