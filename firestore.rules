rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /calls/family_channel {

      // Read: any authenticated user (both flavors use anonymous auth).
      allow read: if request.auth != null;

      // Create: only the initial IDLE document with no sdp.
      allow create: if request.auth != null
                    && request.resource.data.status == 'IDLE'
                    && request.resource.data.seq == 0
                    && !('sdp' in request.resource.data);

      // Update: the room is a signaling channel. Validate the shape.
      // An attacker can still write, but they cannot inject arbitrary
      // fields or change the document structure.
      allow update: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                         ['seq','type','sdp','status','updatedAt'])
                    && request.resource.data.seq is int
                    && request.resource.data.seq >= 0
                    && request.resource.data.status in
                         ['IDLE','RINGING','CONNECTING','CONNECTED','ENDED']
                    && (request.resource.data.type in ['OFFER','ANSWER']
                        || request.resource.data.status == 'IDLE');

      // Delete: forbidden. The document persists across calls.
      allow delete: if false;

      // Candidates subcollection: same auth gate, same shape check.
      match /candidates/{candidateId} {
        allow read, write: if request.auth != null
              && request.resource.data.keys().hasOnly(
                   ['serverUrl','sdpMid','sdpMLineIndex','sdpCandidate'])
              && request.resource.data.sdpCandidate is string
              && request.resource.data.sdpCandidate.size() < 512;
      }
    }

    // Everything else: deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
